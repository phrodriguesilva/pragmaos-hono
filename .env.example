# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# App
APP_URL=http://localhost:3000

# Encryption key for OAuth tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# REQUIRED in production — OAuth tokens will be stored unencrypted if missing.
ENCRYPTION_KEY=

# AI (OpenAI-compatible) — SaaS-managed, global default for all tenants.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_TENANT=10

# CNJ DataJud — SaaS-managed, global API key for all tenants.
CNJ_API_KEY=
CNJ_BASE_URL=https://api-publica.datajud.cnj.jus.br

# --- Per-tenant integrations ---
# These are configured via the Integrations UI (stored in the `integrations` table).
# The fields below are NOT required — they are reference documentation.
# Each integration's credentials are stored in the `config` JSONB column.

# Clicksign: Bearer token from Configuracoes > API
# CLICKSIGN_ACCESS_TOKEN=
# CLICKSIGN_ENVIRONMENT=sandbox  # or production

# WhatsApp Business (Meta Cloud API): token + phone_number_id from Meta Developer Dashboard
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=  # App Secret from Meta app config (for webhook signature verification)
# WHATSAPP_API_VERSION=v21.0

# DocuSign: OAuth 2.0 (JWT Grant) — Integration Key + RSA private key
# DOCUSIGN_CLIENT_ID=
# DOCUSIGN_CLIENT_SECRET=
# DOCUSIGN_ACCOUNT_ID=

# Google Workspace: OAuth 2.0 — Client ID + Secret from Google Cloud Console
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft 365: OAuth 2.0 — Tenant ID + Client ID + Secret from Azure AD
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Gov.br: OAuth 2.0 / OIDC — client_id + secret from gov.br
# GOVBR_CLIENT_ID=
# GOVBR_CLIENT_SECRET=
# GOVBR_REDIRECT_URI=  # defaults to {APP_URL}/auth/govbr/callback

# SMTP (email sending — password reset, notifications)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=  # e.g. "PragmaOS <noreply@pragmaos.com.br>"

# Upstash Redis (optional — distributed rate limiting for serverless)
# Required for production on Vercel (in-memory Map doesn't work across instances).
# Create at https://upstash.com — free tier available.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# Sentry (optional — error tracking in production)
# Create at https://sentry.io — free tier available.
# SENTRY_DSN=https://xxx@sENTRY.io/123
